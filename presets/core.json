{
  "$schema": "../../oxlint/configuration_schema.json",
  "jsPlugins": [
    {
      "name": "oxslop",
      "specifier": "../dist/index.mjs"
    }
  ],
  "rules": {
    "oxslop/no-banned-type-assertions": "error",
    "oxslop/no-chained-type-assertions": "error",
    "oxslop/no-unknown-parameters": "error",
    "oxslop/no-unknown-returns": "error",
    "oxslop/no-unknown-type-aliases": "error",
    "oxslop/no-object-parameters": "error",
    "oxslop/no-unsafe-dictionary-type": "error",
    "oxslop/no-reflect-get": "error",
    "oxslop/no-reflect-apply": "error",
    "oxslop/no-runtime-typeof": "error",
    "oxslop/no-in-operator": "error",
    "oxslop/no-conditional-empty-object-spread": "error",
    "oxslop/no-widen-then-assert": "error",
    "oxslop/no-known-value-widening": "error",
    "oxslop/require-safety-comment-for-type-assertion": "error"
  }
}
